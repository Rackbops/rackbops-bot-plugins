{
  "name": "rackbops-bot-plugins",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Plugins for rackbops-discord-bot, published as npm bundles + a Plugin Index (plugins.json)",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "check": "bunx tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "test": "bun test",
    "build": "bun run scripts/build-plugins.ts",
    "generate-index": "bun run scripts/generate-index.ts",
    "check-contract": "bun run scripts/check-contract.ts",
    "check-core-commands": "bun run scripts/check-core-commands.ts",
    "check-published": "bun run scripts/check-published.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.0",
    "discord.js": "^14.27.0",
    "typescript": "^7.0.0"
  }
}
